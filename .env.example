# Copy this file to `.env.local` and fill in real values.
#   cp .env.example .env.local

# Admin login for the /admin panel.
# ADMIN_USERNAME is optional and defaults to "admin".
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Secret used to sign the session cookie (HMAC-SHA256). REQUIRED.
# Generate a strong value with:  openssl rand -base64 32
# Changing this value invalidates every session at once (admin and customer) —
# it is the site's "log everyone out" switch.
SESSION_SECRET=generate-a-32-byte-random-string

# Optional second factor for the admin login (TOTP, RFC 6238 — Google
# Authenticator, Aegis, 1Password…). Leave EMPTY and the login works exactly as
# before; set it and /login also asks for a 6-digit code.
# Generate a base32 secret with:  openssl rand -base64 20 | base32 | tr -d '='
# then add it to the authenticator app by hand ("enter setup key").
ADMIN_TOTP_SECRET=

# Public origin of the site, e.g. https://pangospodar.com.ua — used to build
# password-reset links. Optional on Vercel (the platform URL is used instead).
# ANYWHERE ELSE it is required: a link built from the request's `Host` header
# would follow whatever host the caller asked for, so without a known origin the
# reset form reports itself as unconfigured instead of mailing such a link.
SITE_URL=

# --- Captcha (Cloudflare Turnstile, optional) ---
# dash.cloudflare.com → Turnstile → Add site. Free, no credit card.
# BOTH must be set or the challenge stays off entirely — the widget is never
# rendered and the Cloudflare script is never loaded.
# Shown only after 3 failed attempts (login, customer login, password reset),
# never on the first try.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Database (Turso / libSQL) ---
# On Vercel the Turso integration provisions these under a STORAGE_ prefix
# (STORAGE_TURSO_DATABASE_URL / STORAGE_TURSO_AUTH_TOKEN) — the app accepts
# either spelling, prefixed first. Locally use the plain names below.
#
# Create the database and read these two values with the Turso CLI:
#   turso db create panhospodar
#   turso db show panhospodar --url        -> TURSO_DATABASE_URL
#   turso db tokens create panhospodar     -> TURSO_AUTH_TOKEN
# Then create the tables:  npm run db:push
#
# For a local dry run with no account at all, point the URL at a file and
# leave the token empty:  TURSO_DATABASE_URL="file:local.db"
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Shared secret for POST /api/import-stock. Must match the value used by the
# import script. Generate with:  openssl rand -hex 32
IMPORT_TOKEN=generate-a-long-random-value

# --- Order notifications ---
# Telegram bot that receives new orders (create via @BotFather).
TELEGRAM_BOT_TOKEN=
# Numeric chat/user id the message is sent to.
TELEGRAM_CHAT_ID=
# Mailbox that receives the order invoice.
ADMIN_EMAIL=
# https://resend.com → API Keys. Without it the email step is skipped
# (the order is still saved and Telegram still fires).
RESEND_API_KEY=
# Sender address on a domain verified in Resend.
# ALSO required for "Забули пароль?": reset links go to the customer's own
# mailbox, and Resend only delivers to arbitrary addresses from a verified
# domain (the shared onboarding@resend.dev sender reaches you alone). Without
# it the reset form honestly says the feature is not configured.
# Check what Resend actually thinks of your setup:  npm run check:email
ORDER_EMAIL_FROM=

# --- Product photo uploads (Vercel Blob) ---
# Vercel dashboard → Storage → create a Blob store → connect it to this project.
# The variable is added automatically once the store is connected; pull it
# locally with:  npx vercel env pull .env.local
# Without it the "Завантажити з пристрою" button in the admin product form
# fails; the URL field keeps working.
BLOB_READ_WRITE_TOKEN=

# --- Nova Poshta ---
# NP cabinet → Налаштування → Безпека → Ключі API.
# Without it the city/branch pickers show a hint instead of suggestions.
NOVA_POSHTA_API_KEY=

# --- Legacy/offline product source (optional) ---
# Used only when no database is configured.
# Path to the УкрСклад export that syncs into a local folder. Accepts a file
# (.csv, .xml, .json) OR a folder (the first products.* / data file inside is
# used). CSV may be UTF-16 or UTF-8; УкрСклад CSV is UTF-16 LE, ";"-delimited.
# Optional — if unset or unreadable, the site falls back to the seed catalog.
# Use forward slashes, even on Windows.
# Example (Google Drive sync folder):
#   UKR_SKLAD_FILE_PATH="G:/Мій диск/UkrSkladSync"
UKR_SKLAD_FILE_PATH=
