# Copy this file to `.env.local` and fill in real values.
#   cp .env.example .env.local

# Admin login for the /admin panel.
# ADMIN_USERNAME is optional and defaults to "admin".
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Secret used to sign the session cookie (HMAC-SHA256). REQUIRED.
# Generate a strong value with:  openssl rand -base64 32
SESSION_SECRET=generate-a-32-byte-random-string

# Path to the УкрСклад export that syncs into a local folder. Accepts a file
# (.csv, .xml, .json) OR a folder (the first products.* / data file inside is
# used). CSV may be UTF-16 or UTF-8; УкрСклад CSV is UTF-16 LE, ";"-delimited.
# Optional — if unset or unreadable, the site falls back to the seed catalog.
# Use forward slashes, even on Windows.
# Example (Google Drive sync folder):
#   UKR_SKLAD_FILE_PATH="G:/Мій диск/UkrSkladSync"
UKR_SKLAD_FILE_PATH=
